@model registerViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-background">
    <div class="glass-card shadow-lg fade-up" style="max-width: 600px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">Join ChatSecure</h2>
            <p class="text-muted small">Start chatting securely in seconds</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
                    <input asp-for="FirstName" class="form-control border-indigo p-3 bg-white" placeholder="John" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
                    <input asp-for="LastName" class="form-control border-indigo p-3 bg-white" placeholder="Doe" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 border-indigo">
                        <i class="bi bi-envelope-at-fill text-indigo" style="color: #6366f1;"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-start-0 border-indigo p-3" placeholder="example@domain.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control border-indigo p-3" placeholder="e.g., +123456789" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 border-indigo">
                            <i class="bi bi-shield-lock-fill text-indigo" style="color: #6366f1;"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control border-start-0 border-indigo p-3" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 border-indigo">
                            <i class="bi bi-shield-lock-fill text-indigo" style="color: #6366f1;"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 border-indigo p-3" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-indigo py-3 rounded-pill text-white fw-bold" style="background: var(--primary-gradient); border: none;">Create My Account</button>
            </div>

            <p class="mt-4 text-center text-muted small">
                Already have an account? <a asp-action="Login" class="text-indigo fw-bold text-decoration-none" style="color: #6366f1;">Sign In here</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
