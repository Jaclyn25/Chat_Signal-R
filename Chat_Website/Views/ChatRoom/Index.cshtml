@using Chat_Website.Models.DataBase
@model IEnumerable<UserApplication>

@{
    ViewData["Title"] = "Chats";
}

<style>
    .contacts-container {
        background: #0f172a;
        min-height: 100vh;
        padding: 0;
    }

    .contacts-header {
        background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
        color: white;
        padding: 24px;
        position: sticky;
        top: 60px;
        z-index: 100;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.15);
    }

    .contacts-header h2 {
        margin: 0;
        font-weight: 700;
        font-size: 24px;
    }

    .search-container {
        padding: 16px 20px;
        background: #1e293b;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .search-input {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: white;
        border-radius: 24px;
        padding: 10px 16px;
        font-size: 14px;
    }

    .search-input::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .search-input:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(99, 102, 241, 0.5);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .contacts-list {
        background: #0f172a;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .contact-item {
        display: flex;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        cursor: pointer;
        transition: background 0.2s ease;
        text-decoration: none;
        color: white;
    }

    .contact-item:hover {
        background: rgba(99, 102, 241, 0.1);
    }

    .contact-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 20px;
        margin-right: 16px;
        flex-shrink: 0;
        object-fit: cover;
    }

    .contact-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .contact-info {
        flex: 1;
        min-width: 0;
    }

    .contact-name {
        font-weight: 600;
        font-size: 15px;
        margin-bottom: 6px;
        color: white;
    }

    .contact-phone {
        font-size: 13px;
        color: #94a3b8;
        display: flex;
        align-items: center;
    }

    .contact-phone i {
        margin-right: 6px;
        font-size: 12px;
    }

    .contact-action {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #6366f1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        transition: all 0.2s ease;
        margin-left: 12px;
        flex-shrink: 0;
        border: none;
        text-decoration: none;
    }

    .contact-action:hover {
        background: #818cf8;
        transform: scale(1.05);
        color: white;
    }

    .contact-action i {
        font-size: 18px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        color: #94a3b8;
        min-height: 400px;
    }

    .empty-state i {
        font-size: 64px;
        margin-bottom: 16px;
        color: #475569;
    }

    .empty-state p {
        font-size: 16px;
        margin: 0;
    }
</style>

<div class="contacts-container">
    <!-- Header -->
    <div class="contacts-header">
        <h2><i class="bi bi-chat-dots-fill me-2"></i>Messages</h2>
    </div>

    <!-- Search Bar -->
    <div class="search-container">
        <input type="text" class="search-input w-100" placeholder="Search people..." id="userSearch">
    </div>

    <!-- Contacts List or Empty State -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>No people available</p>
        </div>
    }
    else
    {
        <ul class="contacts-list" id="contactsList">
            @foreach (var user in Model)
            {
                var userInitial = user.UserName?.FirstOrDefault().ToString().ToUpper() ?? "?";
                <li class="contact-item" data-name="@user.UserName?.ToLower() ?? ''">
                    <!-- Avatar -->
                    <div class="contact-avatar">
                        @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                        {
                            <img src="@user.ProfileImageUrl" alt="@user.UserName" />
                        }
                        else
                        {
                            @userInitial
                        }
                    </div>

                    <!-- Contact Info -->
                    <div class="contact-info">
                        <div class="contact-name">@user.UserName</div>
                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                        {
                            <div class="contact-phone">
                                <i class="bi bi-telephone-fill"></i>
                                @user.PhoneNumber
                            </div>
                        }
                    </div>

                    <!-- Message Button -->
                    <a asp-action="PrivateChat" asp-controller="ChatRoom" asp-route-receiverId="@user.Id" 
                       class="contact-action" title="Send Message">
                        <i class="bi bi-chat-dots-fill"></i>
                    </a>
                </li>
            }
        </ul>
    }
</div>

<script>
    // Search functionality
    document.getElementById('userSearch')?.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const items = document.querySelectorAll('.contact-item');
        
        items.forEach(item => {
            const name = item.getAttribute('data-name');
            if (name.includes(searchTerm)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    });
</script>