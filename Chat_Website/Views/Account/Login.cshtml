@model loginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-background d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="glass-card shadow-lg p-4 p-md-5" style="max-width: 450px; width: 100%;">
        <div class="text-center mb-5">
            <div class="rounded-lg d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; background: var(--gradient-primary) !important; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);">
                <i class="bi bi-shield-lock-fill text-white fs-2"></i>
            </div>
            <h2 class="fw-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; font-size: 28px; letter-spacing: -0.5px; color: var(--text-primary);">Welcome Back</h2>
            <p style="color: var(--text-muted); font-size: 14px; padding: 0 16px; margin: 0;">Secure access to your real-time conversations</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" style="color: #EF4444; margin-bottom: 16px; font-size: 13px;"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label" style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px; margin-bottom: 8px;">Email Address</label>
                <div class="input-group rounded-lg" style="border: 1.5px solid var(--border-color);">
                    <span class="input-group-text" style="background: transparent; border: none; color: var(--text-muted);">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-0" style="color: var(--text-primary);" placeholder="name@company.com" />
                </div>
                <span asp-validation-for="Email" style="color: #EF4444; font-size: 12px;"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label" style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px; margin-bottom: 8px;">Password</label>
                <div class="input-group rounded-lg" style="border: 1.5px solid var(--border-color);">
                    <span class="input-group-text" style="background: transparent; border: none; color: var(--text-muted);">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input asp-for="Password" type="password" class="form-control border-0" style="color: var(--text-primary);" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" style="color: #EF4444; font-size: 12px;"></span>
            </div>

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" style="cursor:pointer; border-color: var(--border-color);" />
                    <label asp-for="RememberMe" class="form-check-label" style="cursor:pointer; color: var(--text-muted); font-size: 14px;">Keep me signed in</label>
                </div>
                <a href="#" class="" style="font-size: 13px; font-weight: 600; color: var(--primary); text-decoration: none;">Forgot?</a>
            </div>

            <div class="d-grid mt-2">
                <button type="submit" class="btn btn-modern-primary py-3" style="font-weight: 600; font-family: 'Space Grotesk', sans-serif; letter-spacing: 0.3px;">
                    Sign In
                </button>
            </div>

            <div class="mt-5 text-center">
                <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 0;">
                    New to LinkUp? <a asp-action="Register" style="color: var(--primary); font-weight: 600; text-decoration: none; transition: all 0.2s;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">Create Account</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
