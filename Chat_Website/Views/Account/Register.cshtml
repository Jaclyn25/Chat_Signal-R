@model registerViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-background">
    <div class="glass-card shadow-lg fade-up" style="max-width: 600px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="font-family: 'Ubuntu', sans-serif; color: var(--text-primary); font-size: 28px;">Join LinkUp</h2>
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 0;">Start chatting securely in seconds</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" style="color: #EF4444; margin-bottom: 16px; font-size: 13px;"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label fw-semibold" style="color: var(--text-primary); font-weight: 600; font-family: 'Ubuntu', sans-serif;">First Name</label>
                    <input asp-for="FirstName" class="form-control" placeholder="John" />
                    <span asp-validation-for="FirstName" style="color: #EF4444; font-size: 12px;"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label fw-semibold" style="color: var(--text-primary); font-weight: 600; font-family: 'Ubuntu', sans-serif;">Last Name</label>
                    <input asp-for="LastName" class="form-control" placeholder="Doe" />
                    <span asp-validation-for="LastName" style="color: #EF4444; font-size: 12px;"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold" style="color: var(--text-primary); font-weight: 600; font-family: 'Ubuntu', sans-serif;">Email Address</label>
                <div class="input-group rounded-lg" style="border: 1.5px solid var(--border-color);">
                    <span class="input-group-text" style="background: transparent; border: none; color: var(--primary);">
                        <i class="bi bi-envelope-at-fill"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-0" placeholder="example@domain.com" />
                </div>
                <span asp-validation-for="Email" style="color: #EF4444; font-size: 12px;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label fw-semibold" style="color: var(--text-primary); font-weight: 600; font-family: 'Ubuntu', sans-serif;">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g., +123456789" />
                <span asp-validation-for="PhoneNumber" style="color: #EF4444; font-size: 12px;"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-semibold" style="color: var(--text-primary); font-weight: 600; font-family: 'Ubuntu', sans-serif;">Password</label>
                    <div class="input-group rounded-lg" style="border: 1.5px solid var(--border-color);">
                        <span class="input-group-text" style="background: transparent; border: none; color: var(--primary);">
                            <i class="bi bi-shield-lock-fill"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control border-0" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" style="color: #EF4444; font-size: 12px;"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold" style="color: var(--text-primary); font-weight: 600; font-family: 'Ubuntu', sans-serif;">Confirm Password</label>
                    <div class="input-group rounded-lg" style="border: 1.5px solid var(--border-color);">
                        <span class="input-group-text" style="background: transparent; border: none; color: var(--primary);">
                            <i class="bi bi-shield-lock-fill"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-0" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" style="color: #EF4444; font-size: 12px;"></span>
                </div>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-modern-primary py-3 rounded-lg" style="font-weight: 600; font-family: 'Space Grotesk', sans-serif; letter-spacing: 0.3px;">Create My Account</button>
            </div>

            <p class="mt-4 text-center" style="color: var(--text-muted); font-size: 14px;">
                Already have an account? <a asp-action="Login" style="color: var(--primary); font-weight: 600; text-decoration: none; transition: all 0.2s;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">Sign In here</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
