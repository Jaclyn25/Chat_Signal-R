@model Chat_Website.ViewModel.Chats.ChatRoomViewModel

@{
    ViewData["Title"] = Model.RoomTitle;
}

<div class="chat-container px-0 d-flex flex-column" style="background: #F8F9FA; height: 100vh; position: fixed; top: 0; left: 0; width: 100%; z-index: 2000;">
    <!-- Chat Header (Fixed at top of container) -->
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center sleek-header" style="background: var(--bg-card); flex-shrink: 0; border-color: var(--border-color);">
        <div class="d-flex align-items-center">
            <div class="p-2 rounded-lg me-3 user-avatar" style="width:45px; height:45px; display:flex; align-items:center; justify-content:center;">
                <i class="bi bi-person-fill"></i>
            </div>
            <div>
                <h5 class="mb-0" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.1rem; letter-spacing: -0.5px; color: var(--text-primary);">@Model.RoomTitle</h5>
                <small class="d-flex align-items-center" id="typingIndicator" style="display:none;"></small>
                <small class="d-flex align-items-center" id="onlineStatus" style="color: var(--text-muted); font-weight: 500;"><span class="status-indicator online me-1"></span>Online</small>
            </div>
        </div>
        <a asp-action="Index" asp-controller="ChatRoom" class="btn btn-sm rounded-lg" style="color: var(--primary); border: 1.5px solid var(--primary); font-weight: 600; font-family: 'Space Grotesk', sans-serif; background: transparent; transition: all 0.3s ease;" onmouseover="this.style.background='rgba(99,102,241,0.08)'" onmouseout="this.style.background='transparent'">
            <i class="bi bi-chevron-left me-1"></i>Back
        </a>
    </div>

    <!-- Messages Area (The ONLY scrollable part) -->
    <div class="flex-grow-1 p-3 overflow-auto d-flex flex-column" id="messagesList" style="background: #F8F9FA; scroll-behavior: smooth;">
        <div class="mt-auto"></div> <!-- Push messages to bottom if few -->
        @foreach (var msg in Model.Messages)
        {
            var currentUserName = User.Identity?.Name ?? "";
            var isCurrentUser = msg.UserName == currentUserName;
            <div class="mb-3 d-flex @(isCurrentUser ? "justify-content-end" : "justify-content-start") w-100" id="msg-@msg.Id">
                <div class="bubble @(isCurrentUser ? "bubble-mine" : "bubble-theirs")">
                    @if (!Model.IsPrivate && !isCurrentUser)
                    {
                        <div class="d-flex align-items-center mb-2">
                            @if (!string.IsNullOrEmpty(msg.ProfileImageUrl))
                            {
                                <img src="@msg.ProfileImageUrl" alt="@msg.UserName" class="rounded me-2" style="width: 24px; height: 24px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded me-2 d-flex align-items-center justify-content-center text-white fw-bold" style="width: 24px; height: 24px; font-size: 11px; font-weight: 700; background: linear-gradient(135deg, #6366F1 0%, #8B7FFF 100%);">
                                    @(msg.UserName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                </div>
                            }
                            <div class="fw-bold small" style="color: var(--text-primary); font-family: 'Space Grotesk', sans-serif; letter-spacing: 0.2px; font-weight: 600;">@msg.UserName</div>
                        </div>
                    }

                    <div class="message-content">@msg.Content</div>
                    <div class="timestamp-text d-flex align-items-center justify-content-end mt-1">
                        <span>@msg.Timestamp.ToString("HH:mm")</span>
                        @if(isCurrentUser) { 
                            <i class="bi @(msg.IsSeen ? "bi-check2-all text-info" : "bi-check2") ms-1 seen-icon" id="seen-@msg.Id"></i> 
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Input Area (Fixed at bottom of container) -->
    <div class="p-3 border-top" style="background: var(--bg-card) !important; border-color: var(--border-color); flex-shrink: 0;">
        <div class="input-group rounded-lg p-2" style="background: var(--bg-light); border: 1.5px solid var(--border-color);">
            <input type="hidden" id="roomIdInput" value="@Model.RoomId" />
            <input type="hidden" id="userInput" value="@(User.Identity?.Name ?? "")" />
            
            <button class="btn btn-link" style="color: var(--text-muted);"><i class="bi bi-paperclip fs-5"></i></button>
            <input type="text" id="messageInput" class="form-control border-0 bg-transparent px-3" placeholder="Message..." autocomplete="off" style="color: var(--text-primary); font-family: 'Sora', sans-serif;" />
            <button class="btn rounded-lg p-0 send-btn-bounce" id="sendButton" style="width:44px; height:44px; background: var(--gradient-primary); color: white; border: none; margin: 2px;">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        var isPrivateRoom = @Model.IsPrivate.ToString().ToLower();
        
        // Handle send button animation
        document.getElementById('sendButton').addEventListener('click', function() {
            this.classList.add('send-btn-bounce');
            setTimeout(() => this.classList.remove('send-btn-bounce'), 300);
        });
    </script>

    <script src="~/js/chat.js"></script>
}
