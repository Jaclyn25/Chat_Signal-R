<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatSecure</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Chat_Website.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><circle cx='8' cy='8' r='7' fill='%236366f1'/><circle cx='8' cy='8' r='3' fill='white' class='favicon-dot'/></svg>">
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "authenticated-layout" : "auth-background")">
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        var user = await UserManager.GetUserAsync(User);
        <header class="sleek-header sticky-top">
            <nav class="navbar navbar-expand-sm py-2">
                <div class="container-fluid px-4">
                    <a class="navbar-brand fw-bold d-flex align-items-center text-white" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shield-lock-fill me-2" style="color: #6366f1; font-size: 1.5rem;"></i>
                        ChatSecure
                    </a>
                    <div class="d-flex align-items-center">
                        <div class="dropdown">
                            <button class="btn border-0 p-0 d-flex align-items-center text-white" type="button" data-bs-toggle="dropdown">
                                <div class="avatar-circle-nav me-2 shadow-sm d-flex align-items-center justify-content-center overflow-hidden" 
                                     style="width: 38px; height: 38px; background: rgba(255,255,255,0.1); border: 1.5px solid rgba(255,255,255,0.2); border-radius: 10px;">
                                    @if (user != null && !string.IsNullOrEmpty(user.ProfileImageUrl))
                                    {
                                        <img src="@user.ProfileImageUrl" alt="Avatar" style="width:100%; height:100%; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill text-white-50" style="font-size: 1.25rem;"></i>
                                    }
                                </div>
                                <span class="d-none d-sm-inline fw-semibold text-white">@User.Identity.Name</span>
                                <i class="bi bi-chevron-down ms-2 small text-white-50"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 p-2" style="border-radius: 12px; min-width: 200px;">
                                <li class="px-3 py-2 border-bottom mb-2">
                                    <span class="d-block small text-muted">Signed in as</span>
                                    <span class="fw-bold text-dark">@User.Identity.Name</span>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 mb-1 py-2" asp-controller="Settings" asp-action="Profile">
                                        <i class="bi bi-person-gear me-2 text-muted"></i>Settings
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 text-danger py-2" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-power me-2"></i>Sign Out
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="bottom-nav">
            <a class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ChatRoom" ? "active" : "")" asp-controller="ChatRoom" asp-action="Index">
                <i class="bi bi-chat-text-fill"></i>
                <span>Chats</span>
            </a>
            <a class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Profile">
                <i class="bi bi-person-fill"></i>
                <span>Profile</span>
            </a>
        </footer>
    }
    else
    {
        <main role="main" class="w-100" style="background:#f8fafc">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

