<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinkUp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Chat_Website.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><circle cx='8' cy='8' r='7' fill='%236366F1'/><circle cx='8' cy='8' r='3' fill='white' class='favicon-dot'/></svg>">
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "authenticated-layout" : "auth-background")">
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        var user = await UserManager.GetUserAsync(User);
        <header class="sleek-header sticky-top">
            <nav class="navbar navbar-expand-sm py-2">
                <div class="container-fluid px-4">
                    <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index" style="color: var(--primary); font-family: 'Ubuntu', sans-serif; font-size: 1.3rem; letter-spacing: -0.5px;">
                        <i class="bi bi-shield-lock-fill me-2" style="font-size: 1.5rem;"></i>
                        LinkUp
                    </a>
                    <div class="d-flex align-items-center">
                        <div class="dropdown">
                            <button class="btn border-0 p-0 d-flex align-items-center" type="button" data-bs-toggle="dropdown" style="font-weight: 600; color: var(--text-primary); transition: all 0.2s;">
                                <div class="avatar-circle-nav me-2 d-flex align-items-center justify-content-center overflow-hidden" 
                                     style="width: 38px; height: 38px; background: var(--gradient-primary); border: 1.5px solid var(--primary-lighter); border-radius: 10px; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);">
                                    @if (user != null && !string.IsNullOrEmpty(user.ProfileImageUrl))
                                    {
                                        <img src="@user.ProfileImageUrl" alt="Avatar" style="width:100%; height:100%; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill" style="font-size: 1.25rem; color: white;"></i>
                                    }
                                </div>
                                <span class="d-none d-sm-inline fw-semibold" style="font-family: 'Ubuntu', sans-serif; letter-spacing: 0.2px; font-size: 0.95rem;">@User.Identity.Name</span>
                                <i class="bi bi-chevron-down ms-2 small" style="font-weight: 700; color: var(--text-muted);"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 mt-2 p-2" style="border-radius: 12px; min-width: 200px; background: var(--bg-card); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);">
                                <li class="px-3 py-2" style="border-bottom: 1px solid var(--border-color); margin-bottom: 8px;">
                                    <span class="d-block small" style="color: var(--text-muted);">Signed in as</span>
                                    <span class="fw-bold" style="color: var(--text-primary); font-family: 'Ubuntu', sans-serif;">@User.Identity.Name</span>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-lg mb-1 py-2" asp-controller="Settings" asp-action="Profile" style="color: var(--text-primary); transition: all 0.2s;" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
                                        <i class="bi bi-person-gear me-2" style="color: var(--primary);"></i>Settings
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-lg py-2" asp-controller="Account" asp-action="Logout" style="color: #EF4444; transition: all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.08)'" onmouseout="this.style.background='transparent'">
                                        <i class="bi bi-power me-2"></i>Sign Out
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="bottom-nav">
            <a class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ChatRoom" ? "active" : "")" asp-controller="ChatRoom" asp-action="Index">
                <i class="bi bi-chat-text-fill"></i>
                <span>Chats</span>
            </a>
            <a class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Profile">
                <i class="bi bi-person-fill"></i>
                <span>Profile</span>
            </a>
        </footer>
    }
    else
    {
        <main role="main" class="w-100" style="background: var(--bg-main);">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

